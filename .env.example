# Postgres connection used by Drizzle (db/index.ts) and the seed script.
DATABASE_URL=postgresql://veloce:veloce_dev_2026@localhost:5432/veloce

# Local Ollama daemon that powers the chatbot. If unreachable, the chat route
# falls back to the deterministic catalog responder in lib/chat/fallback.ts.
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b

# Signs the session cookies. The storefront cookie is mock-auth; the ADMIN
# cookie is real (bcrypt + HMAC), and lib/admin/auth.ts refuses to start in
# production while this is unset or left as "change_me". Replace it.
SESSION_SECRET=change_me

# Seed credentials for the CMS owner account (db/seed-cms.ts). Change these,
# then sign in at /admin/login. Password is stored bcrypt-hashed, never plain.
ADMIN_EMAIL=admin@veloce.com
ADMIN_PASSWORD=veloce-admin-2026

# HubSpot CRM. API key is a Private App access token (pat-...); needs contacts,
# deals and tickets WRITE scopes. Portal id builds "Open in HubSpot" deep links.
HUBSPOT_API_KEY=
HUBSPOT_PORTAL_ID=
